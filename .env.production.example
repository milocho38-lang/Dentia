# Dentia production environment template.
# Copy outside Git-tracked history or keep root-only with chmod 600.
# Never commit real values.

APP_ENV=production
APP_DEBUG=false
DEFAULT_TENANT_MAX_ACTIVE_DENTISTS=1

POSTGRES_DB=__REQUIRED_DATABASE_NAME__
POSTGRES_USER=__REQUIRED_DATABASE_USER__
POSTGRES_PASSWORD=__REQUIRED_DATABASE_PASSWORD__

# Use URL-encoded credentials when building DATABASE_URL.
DATABASE_URL=postgresql+psycopg://__USER__:__URL_ENCODED_PASSWORD__@dentia-db:5432/__DATABASE__
JWT_SECRET=__REQUIRED_RANDOM_SECRET_AT_LEAST_32_BYTES__

DENTIA_BACKEND_ENV_FILE=./.env.production
BRANDING_STORAGE_DIR=/app/storage/branding
API_PROXY_TARGET=http://dentia-backend:8000
PUBLIC_FRONTEND_URL=https://dentiapro.com

# Configure these values only during the authorized production rollout.
CONSENT_ACCEPTANCE_ENABLED=true
CONSENT_PUBLIC_COOKIE_SECURE=true
CONSENT_FINAL_STORAGE_DIR=/app/storage/consents
CONSENT_STORAGE_PERSISTENT=true
CONSENT_PROCEDURE_VERSION=DENTIA_CONSENT_PROCEDURE_V1
CONSENT_OTP_EXPIRE_MINUTES=10
CONSENT_OTP_MAX_ATTEMPTS=5
CONSENT_PUBLIC_SESSION_MINUTES=30
SMTP_HOST=__REQUIRED_SMTP_HOST__
SMTP_FROM_EMAIL=__REQUIRED_SMTP_FROM_EMAIL__

DENTIA_BACKEND_BIND=8001
DENTIA_FRONTEND_BIND=3001
DENTIA_DB_CONTAINER=dentia-db
DENTIA_BACKEND_CONTAINER=dentia-backend
DENTIA_FRONTEND_CONTAINER=dentia-frontend
